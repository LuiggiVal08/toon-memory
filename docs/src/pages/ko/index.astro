---
import logoSrc from '../../assets/logo.svg';
import SiteHeader from '../../components/SiteHeader.astro';
import Hero from '../../components/Hero.astro';
import Problem from '../../components/Problem.astro';
import Continuity from '../../components/Continuity.astro';
import Benefits from '../../components/Benefits.astro';
import FeatureGrid from '../../components/FeatureGrid.astro';
import MemoryGraphShowcase from '../../components/MemoryGraphShowcase.astro';
import Tools from '../../components/Tools.astro';
import Benchmarks from '../../components/Benchmarks.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import Agents from '../../components/Agents.astro';
import Comparison from '../../components/Comparison.astro';
import FAQ from '../../components/FAQ.astro';
import CTA from '../../components/CTA.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import '../../styles/home.css';

const description =
  'AI 에이전트를 위한 연속성 레이어. AI 에이전트는 매 세션마다 프로젝트를 다시 배우지 않아야 합니다 — toon-memory는 세션을 넘어 프로젝트의 지식, 결정, 관례를 보존합니다. 로컬에서 안전하게, Claude, Codex, Cursor, OpenCode 및 20개 이상의 에이전트 지원.';
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>toon-memory — AI 에이전트를 위한 연속성 레이어</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={logoSrc.src} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="toon-memory — AI 코딩 에이전트를 위한 연속성 | 세션 간 메모리" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://luiggival08.github.io/toon-memory/ko/" />
    <meta property="og:image" content="https://luiggival08.github.io/toon-memory/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="toon-memory" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="toon-memory" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://luiggival08.github.io/toon-memory/og-image.png" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <SiteHeader lang="ko" />

    <main>
      <Hero lang="ko" />
      <Problem lang="ko" />
      <Continuity lang="ko" />
      <Benefits lang="ko" />
      <Comparison lang="ko" />
      <Benchmarks lang="ko" />
      <HowItWorks lang="ko" />
      <FeatureGrid lang="ko" />
      <MemoryGraphShowcase lang="ko" />
      <Tools lang="ko" />
      <Agents lang="ko" />
      <FAQ lang="ko" />
      <CTA lang="ko" />
    </main>

    <SiteFooter lang="ko" />
  </body>
</html>
