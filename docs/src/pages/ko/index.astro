---
import logoSrc from '../../assets/logo.svg';
import SiteHeader from '../../components/SiteHeader.astro';
import Hero from '../../components/Hero.astro';
import Problem from '../../components/Problem.astro';
import FeatureGrid from '../../components/FeatureGrid.astro';
import MemoryGraphShowcase from '../../components/MemoryGraphShowcase.astro';
import SmartRecallShowcase from '../../components/SmartRecallShowcase.astro';
import Tools from '../../components/Tools.astro';
import Benchmarks from '../../components/Benchmarks.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import Agents from '../../components/Agents.astro';
import Comparison from '../../components/Comparison.astro';
import FAQ from '../../components/FAQ.astro';
import CTA from '../../components/CTA.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import WhatNew from '../../components/WhatNew.astro';
import '../../styles/home.css';

const description =
  '세션보다 오래 지속되는 메모리를 AI 코딩 에이전트에 제공 — 의사결정, 패턴, 버그를 세션 간에 기억하며, 오프라인 및 토큰 효율적, Claude, Cursor, OpenCode, Windsurf 및 15개 이상의 에이전트 지원. 재현 가능한 리콜 벤치마크: npm run bench:retrieval.';
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>toon-memory — AI 코딩 에이전트를 위한 연속성 | 세션 간 메모리</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={logoSrc.src} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="toon-memory — AI 코딩 에이전트를 위한 연속성 | 세션 간 메모리" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://luiggival08.github.io/toon-memory/ko/" />
    <meta property="og:image" content="https://luiggival08.github.io/toon-memory/favicon.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="toon-memory" />
    <meta name="twitter:description" content={description} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <SiteHeader lang="ko" />

    <main>
      <Hero lang="ko" />
      <Problem lang="ko" />
      <MemoryGraphShowcase lang="ko" />
      <Benchmarks lang="ko" />
      <FeatureGrid lang="ko" />
      <SmartRecallShowcase lang="ko" />
      <Tools lang="ko" />
      <WhatNew lang="ko" />
      <HowItWorks lang="ko" />
      <Agents lang="ko" />
      <Comparison lang="ko" />
      <FAQ lang="ko" />
      <CTA lang="ko" />
    </main>

    <SiteFooter lang="ko" />
  </body>
</html>
