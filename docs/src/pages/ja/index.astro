---
import logoSrc from '../../assets/logo.svg';
import SiteHeader from '../../components/SiteHeader.astro';
import Hero from '../../components/Hero.astro';
import Problem from '../../components/Problem.astro';
import Continuity from '../../components/Continuity.astro';
import Benefits from '../../components/Benefits.astro';
import FeatureGrid from '../../components/FeatureGrid.astro';
import MemoryGraphShowcase from '../../components/MemoryGraphShowcase.astro';
import Tools from '../../components/Tools.astro';
import Benchmarks from '../../components/Benchmarks.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import Agents from '../../components/Agents.astro';
import Comparison from '../../components/Comparison.astro';
import FAQ from '../../components/FAQ.astro';
import CTA from '../../components/CTA.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import WhatNew from '../../components/WhatNew.astro';
import '../../styles/home.css';

const description =
  'AIエージェントのための継続性レイヤー。AIエージェントは毎セッションでプロジェクトを学び直すべきではありません — toon-memory はプロジェクトの知識・決定・規約をセッションを超えて保存します。ローカルかつプライベートに、Claude、Codex、Cursor、OpenCode、そして15以上のエージェントに対応。';
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>toon-memory — AIエージェントのための継続性レイヤー</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={logoSrc.src} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="toon-memory — AIコーディングエージェントの継続性 | セッションを超えたメモリ" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://luiggival08.github.io/toon-memory/ja/" />
    <meta property="og:image" content="https://luiggival08.github.io/toon-memory/favicon.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="toon-memory" />
    <meta name="twitter:description" content={description} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <SiteHeader lang="ja" />

    <main>
      <Hero lang="ja" />
      <Problem lang="ja" />
      <Continuity lang="ja" />
      <Benefits lang="ja" />
      <Comparison lang="ja" />
      <Benchmarks lang="ja" />
      <HowItWorks lang="ja" />
      <FeatureGrid lang="ja" />
      <MemoryGraphShowcase lang="ja" />
      <Tools lang="ja" />
      <Agents lang="ja" />
      <WhatNew lang="ja" />
      <FAQ lang="ja" />
      <CTA lang="ja" />
    </main>

    <SiteFooter lang="ja" />
  </body>
</html>
