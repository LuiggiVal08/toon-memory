---
import logoSrc from '../../assets/logo.svg';
import SiteHeader from '../../components/SiteHeader.astro';
import Hero from '../../components/Hero.astro';
import Problem from '../../components/Problem.astro';
import FeatureGrid from '../../components/FeatureGrid.astro';
import MemoryGraphShowcase from '../../components/MemoryGraphShowcase.astro';
import SmartRecallShowcase from '../../components/SmartRecallShowcase.astro';
import Tools from '../../components/Tools.astro';
import ImpactShowcase from '../../components/ImpactShowcase.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import Agents from '../../components/Agents.astro';
import Comparison from '../../components/Comparison.astro';
import TokenSavings from '../../components/TokenSavings.astro';
import FAQ from '../../components/FAQ.astro';
import CTA from '../../components/CTA.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import '../../styles/home.css';

const description =
  'AIコーディングエージェント向けMCPメモリサーバー — 21ツール、セッションあたりツール呼び出し80%削減。セッション間で意思決定、パターン、バグを記憶。';
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>toon-memory — AIコーディングエージェント向けMCPメモリサーバー</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={logoSrc.src} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="toon-memory — AIコーディングエージェント向けMCPメモリサーバー" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://luiggival08.github.io/toon-memory/ja/" />
    <meta property="og:image" content="https://luiggival08.github.io/toon-memory/favicon.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="toon-memory" />
    <meta name="twitter:description" content={description} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <SiteHeader lang="ja" />

    <main>
      <Hero lang="ja" />
      <Problem lang="ja" />
      <ImpactShowcase lang="ja" />
      <TokenSavings lang="ja" />
      <FeatureGrid lang="ja" />
      <MemoryGraphShowcase lang="ja" />
      <SmartRecallShowcase lang="ja" />
      <Tools lang="ja" />
      <HowItWorks lang="ja" />
      <Agents lang="ja" />
      <Comparison lang="ja" />
      <FAQ lang="ja" />
      <CTA lang="ja" />
    </main>

    <SiteFooter lang="ja" />
  </body>
</html>
