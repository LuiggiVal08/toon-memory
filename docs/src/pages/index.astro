---
import logoSrc from '../assets/logo.svg';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import Problem from '../components/Problem.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import MemoryGraphShowcase from '../components/MemoryGraphShowcase.astro';
import SmartRecallShowcase from '../components/SmartRecallShowcase.astro';
import Tools from '../components/Tools.astro';
import Benchmarks from '../components/Benchmarks.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Agents from '../components/Agents.astro';
import Comparison from '../components/Comparison.astro';
import WhatNew from '../components/WhatNew.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/home.css';

const description =
  'MCP memory server giving AI coding agents (Claude, Cursor, OpenCode, Windsurf) offline, token-efficient persistent memory. 35 tools, ~90% fewer tokens with auto-loading, 80% fewer tool calls. Remember decisions, patterns, and bugs between sessions.';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "toon-memory",
  "description": description,
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "Cross-platform",
  "url": "https://luiggival08.github.io/toon-memory/",
  "downloadUrl": "https://www.npmjs.com/package/toon-memory",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "author": {
    "@type": "Person",
    "name": "LuiggiVal"
  },
  "keywords": "MCP memory server, persistent memory AI agents, Claude memory, Cursor memory, OpenCode memory, Model Context Protocol, token-efficient memory, BM25 recall"
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>toon-memory — MCP Memory Server for AI Coding Agents | Persistent Memory</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="MCP memory server, persistent memory AI agents, Claude memory, Cursor memory, OpenCode memory, Model Context Protocol, token-efficient memory, BM25 recall, knowledge graph memory, AI coding agent, auto-loading" />
    <link rel="icon" type="image/svg+xml" href={logoSrc.src} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="toon-memory — MCP Memory Server for AI Coding Agents" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://luiggival08.github.io/toon-memory/" />
    <meta property="og:image" content="https://luiggival08.github.io/toon-memory/og-image.svg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="toon-memory" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="toon-memory — MCP Memory Server for AI Coding Agents" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://luiggival08.github.io/toon-memory/og-image.svg" />
    <link rel="canonical" href="https://luiggival08.github.io/toon-memory/" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      document.documentElement.classList.add('js');
      (function () {
        try {
          if (localStorage.getItem('toon-lang') === 'en') return;
          var langs = navigator.languages || [navigator.language || ''];
          var prefersEs = langs.some(function (l) {
            return String(l).toLowerCase().indexOf('es') === 0;
          });
          if (prefersEs) window.location.replace('/toon-memory/es');
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <SiteHeader />

    <main>
      <Hero />
      <Problem />
      <MemoryGraphShowcase />
      <Benchmarks />
      <FeatureGrid />
      <SmartRecallShowcase />
      <Tools />
      <WhatNew />
      <HowItWorks />
      <Agents />
      <Comparison />
      <FAQ />
      <CTA />
    </main>

    <SiteFooter />
  </body>
</html>
