---
import logoSrc from '../../assets/logo.svg';
import SiteHeader from '../../components/SiteHeader.astro';
import Hero from '../../components/Hero.astro';
import Problem from '../../components/Problem.astro';
import Continuity from '../../components/Continuity.astro';
import Benefits from '../../components/Benefits.astro';
import FeatureGrid from '../../components/FeatureGrid.astro';
import MemoryGraphShowcase from '../../components/MemoryGraphShowcase.astro';
import Tools from '../../components/Tools.astro';
import Benchmarks from '../../components/Benchmarks.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import Agents from '../../components/Agents.astro';
import Comparison from '../../components/Comparison.astro';
import FAQ from '../../components/FAQ.astro';
import CTA from '../../components/CTA.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import WhatNew from '../../components/WhatNew.astro';
import '../../styles/home.css';

const description =
  '面向 AI 代理的连续性层。AI 代理不应该在每个会话中重新学习你的项目 — toon-memory 跨会话保存项目的知识、决策和约定。本地化、私密化，适用于 Claude、Codex、Cursor、OpenCode 及 15+ 个代理。';
---

<!doctype html>
<html lang="zh">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>toon-memory — 面向 AI 代理的连续性层</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={logoSrc.src} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="toon-memory — AI 编程代理的连续性 | 跨会话记忆" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://luiggival08.github.io/toon-memory/zh/" />
    <meta property="og:image" content="https://luiggival08.github.io/toon-memory/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="toon-memory" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="toon-memory" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://luiggival08.github.io/toon-memory/og-image.png" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <SiteHeader lang="zh" />

    <main>
      <Hero lang="zh" />
      <Problem lang="zh" />
      <Continuity lang="zh" />
      <Benefits lang="zh" />
      <Comparison lang="zh" />
      <Benchmarks lang="zh" />
      <HowItWorks lang="zh" />
      <FeatureGrid lang="zh" />
      <MemoryGraphShowcase lang="zh" />
      <Tools lang="zh" />
      <Agents lang="zh" />
      <WhatNew lang="zh" />
      <FAQ lang="zh" />
      <CTA lang="zh" />
    </main>

    <SiteFooter lang="zh" />
  </body>
</html>
