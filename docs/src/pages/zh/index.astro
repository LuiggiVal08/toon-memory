---
import logoSrc from '../../assets/logo.svg';
import SiteHeader from '../../components/SiteHeader.astro';
import Hero from '../../components/Hero.astro';
import Problem from '../../components/Problem.astro';
import FeatureGrid from '../../components/FeatureGrid.astro';
import MemoryGraphShowcase from '../../components/MemoryGraphShowcase.astro';
import SmartRecallShowcase from '../../components/SmartRecallShowcase.astro';
import Tools from '../../components/Tools.astro';
import Benchmarks from '../../components/Benchmarks.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import Agents from '../../components/Agents.astro';
import Comparison from '../../components/Comparison.astro';
import FAQ from '../../components/FAQ.astro';
import CTA from '../../components/CTA.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import WhatNew from '../../components/WhatNew.astro';
import '../../styles/home.css';

const description =
  '给你的 AI 编程代理一个比会话更持久的记忆 — 跨会话记住决策、模式和 Bug，离线且 token 高效，适用于 Claude、Cursor、OpenCode、Windsurf 及 15+ 个代理。可复现的召回基准测试：npm run bench:retrieval。';
---

<!doctype html>
<html lang="zh">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>toon-memory — AI 编程代理的连续性 | 跨会话记忆</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={logoSrc.src} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="toon-memory — AI 编程代理的连续性 | 跨会话记忆" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://luiggival08.github.io/toon-memory/zh/" />
    <meta property="og:image" content="https://luiggival08.github.io/toon-memory/favicon.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="toon-memory" />
    <meta name="twitter:description" content={description} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <SiteHeader lang="zh" />

    <main>
      <Hero lang="zh" />
      <Problem lang="zh" />
      <MemoryGraphShowcase lang="zh" />
      <Benchmarks lang="zh" />
      <FeatureGrid lang="zh" />
      <SmartRecallShowcase lang="zh" />
      <Tools lang="zh" />
      <WhatNew lang="zh" />
      <HowItWorks lang="zh" />
      <Agents lang="zh" />
      <Comparison lang="zh" />
      <FAQ lang="zh" />
      <CTA lang="zh" />
    </main>

    <SiteFooter lang="zh" />
  </body>
</html>
