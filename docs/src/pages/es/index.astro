---
import logoSrc from '../../assets/logo.svg';
import SiteHeader from '../../components/SiteHeader.astro';
import Hero from '../../components/Hero.astro';
import Problem from '../../components/Problem.astro';
import Continuity from '../../components/Continuity.astro';
import Benefits from '../../components/Benefits.astro';
import FeatureGrid from '../../components/FeatureGrid.astro';
import MemoryGraphShowcase from '../../components/MemoryGraphShowcase.astro';
import Tools from '../../components/Tools.astro';
import Benchmarks from '../../components/Benchmarks.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import Agents from '../../components/Agents.astro';
import Comparison from '../../components/Comparison.astro';
import FAQ from '../../components/FAQ.astro';
import CTA from '../../components/CTA.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import '../../styles/home.css';

const description =
  'La capa de continuidad para agentes de IA. Los agentes de IA no deberían tener que reaprender tu proyecto en cada sesión — toon-memory preserva el conocimiento, las decisiones y las convenciones del proyecto entre sesiones, de forma local y privada, para Claude, Codex, Cursor, OpenCode y 20+ agentes.';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>toon-memory — La capa de continuidad para agentes de IA</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={logoSrc.src} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="toon-memory — La capa de continuidad para agentes de IA" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://luiggival08.github.io/toon-memory/es/" />
    <meta property="og:image" content="https://luiggival08.github.io/toon-memory/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="toon-memory" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="toon-memory" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://luiggival08.github.io/toon-memory/og-image.png" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <SiteHeader lang="es" />

    <main>
      <Hero lang="es" />
      <Problem lang="es" />
      <Continuity lang="es" />
      <Benefits lang="es" />
      <Comparison lang="es" />
      <Benchmarks lang="es" />
      <HowItWorks lang="es" />
      <FeatureGrid lang="es" />
      <MemoryGraphShowcase lang="es" />
      <Tools lang="es" />
      <Agents lang="es" />
      <FAQ lang="es" />
      <CTA lang="es" />
    </main>

    <SiteFooter lang="es" />
  </body>
</html>
