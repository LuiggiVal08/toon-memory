---
import logoSrc from '../../assets/logo.svg';
import SiteHeader from '../../components/SiteHeader.astro';
import Hero from '../../components/Hero.astro';
import Problem from '../../components/Problem.astro';
import FeatureGrid from '../../components/FeatureGrid.astro';
import MemoryGraphShowcase from '../../components/MemoryGraphShowcase.astro';
import SmartRecallShowcase from '../../components/SmartRecallShowcase.astro';
import Tools from '../../components/Tools.astro';
import Benchmarks from '../../components/Benchmarks.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import Agents from '../../components/Agents.astro';
import Comparison from '../../components/Comparison.astro';
import FAQ from '../../components/FAQ.astro';
import CTA from '../../components/CTA.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import WhatNew from '../../components/WhatNew.astro';
import '../../styles/home.css';

const description =
  'Servidor de memoria MCP para agentes de IA — 35 herramientas, 80% menos tool calls por sesión. Recuerda decisiones, patrones y bugs entre sesiones.';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>toon-memory — Servidor de memoria MCP para agentes de IA</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={logoSrc.src} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="toon-memory — Servidor de memoria MCP para agentes de IA" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://luiggival08.github.io/toon-memory/es/" />
    <meta property="og:image" content="https://luiggival08.github.io/toon-memory/favicon.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="toon-memory" />
    <meta name="twitter:description" content={description} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <SiteHeader lang="es" />

    <main>
      <Hero lang="es" />
      <Problem lang="es" />
      <MemoryGraphShowcase lang="es" />
      <Benchmarks lang="es" />
      <FeatureGrid lang="es" />
      <SmartRecallShowcase lang="es" />
      <Tools lang="es" />
      <WhatNew lang="es" />
      <HowItWorks lang="es" />
      <Agents lang="es" />
      <Comparison lang="es" />
      <FAQ lang="es" />
      <CTA lang="es" />
    </main>

    <SiteFooter lang="es" />
  </body>
</html>
