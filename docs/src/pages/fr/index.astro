---
import logoSrc from '../../assets/logo.svg';
import SiteHeader from '../../components/SiteHeader.astro';
import Hero from '../../components/Hero.astro';
import Problem from '../../components/Problem.astro';
import FeatureGrid from '../../components/FeatureGrid.astro';
import MemoryGraphShowcase from '../../components/MemoryGraphShowcase.astro';
import SmartRecallShowcase from '../../components/SmartRecallShowcase.astro';
import Tools from '../../components/Tools.astro';
import Benchmarks from '../../components/Benchmarks.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import Agents from '../../components/Agents.astro';
import Comparison from '../../components/Comparison.astro';
import FAQ from '../../components/FAQ.astro';
import CTA from '../../components/CTA.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import WhatNew from '../../components/WhatNew.astro';
import '../../styles/home.css';

const description =
  'Serveur MCP de mémoire pour agents de codage IA — 40 outils, 80% moins d\'appels d\'outils par session. Mémorisez les décisions, patterns et bugs entre les sessions.';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>toon-memory — Serveur MCP de mémoire pour agents de codage IA</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={logoSrc.src} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="toon-memory — Serveur MCP de mémoire pour agents de codage IA" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://luiggival08.github.io/toon-memory/fr/" />
    <meta property="og:image" content="https://luiggival08.github.io/toon-memory/favicon.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="toon-memory" />
    <meta name="twitter:description" content={description} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <SiteHeader lang="fr" />

    <main>
      <Hero lang="fr" />
      <Problem lang="fr" />
      <MemoryGraphShowcase lang="fr" />
      <Benchmarks lang="fr" />
      <FeatureGrid lang="fr" />
      <SmartRecallShowcase lang="fr" />
      <Tools lang="fr" />
      <WhatNew lang="fr" />
      <HowItWorks lang="fr" />
      <Agents lang="fr" />
      <Comparison lang="fr" />
      <FAQ lang="fr" />
      <CTA lang="fr" />
    </main>

    <SiteFooter lang="fr" />
  </body>
</html>
