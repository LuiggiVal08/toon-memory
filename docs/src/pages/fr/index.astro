---
import logoSrc from '../../assets/logo.svg';
import SiteHeader from '../../components/SiteHeader.astro';
import Hero from '../../components/Hero.astro';
import Problem from '../../components/Problem.astro';
import Continuity from '../../components/Continuity.astro';
import Benefits from '../../components/Benefits.astro';
import FeatureGrid from '../../components/FeatureGrid.astro';
import MemoryGraphShowcase from '../../components/MemoryGraphShowcase.astro';
import Tools from '../../components/Tools.astro';
import Benchmarks from '../../components/Benchmarks.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import Agents from '../../components/Agents.astro';
import Comparison from '../../components/Comparison.astro';
import FAQ from '../../components/FAQ.astro';
import CTA from '../../components/CTA.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import WhatNew from '../../components/WhatNew.astro';
import '../../styles/home.css';

const description =
  'La couche de continuité pour les agents IA. Les agents IA ne devraient pas avoir à réapprendre votre projet à chaque session — toon-memory préserve le savoir, les décisions et les conventions de votre projet entre les sessions, localement et en privé, pour Claude, Codex, Cursor, OpenCode et 15+ agents.';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>toon-memory — La couche de continuité pour les agents IA</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={logoSrc.src} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="toon-memory — La continuité pour les agents de codage IA | Mémoire entre les sessions" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://luiggival08.github.io/toon-memory/fr/" />
    <meta property="og:image" content="https://luiggival08.github.io/toon-memory/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="toon-memory" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="toon-memory" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://luiggival08.github.io/toon-memory/og-image.png" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <SiteHeader lang="fr" />

    <main>
      <Hero lang="fr" />
      <Problem lang="fr" />
      <Continuity lang="fr" />
      <Benefits lang="fr" />
      <Comparison lang="fr" />
      <Benchmarks lang="fr" />
      <HowItWorks lang="fr" />
      <FeatureGrid lang="fr" />
      <MemoryGraphShowcase lang="fr" />
      <Tools lang="fr" />
      <Agents lang="fr" />
      <WhatNew lang="fr" />
      <FAQ lang="fr" />
      <CTA lang="fr" />
    </main>

    <SiteFooter lang="fr" />
  </body>
</html>
