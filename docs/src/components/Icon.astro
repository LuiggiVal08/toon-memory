const svg = icons[emoji] || '';
---

{svg ? (
  <span class:list={['icon-svg', className]} set:html={`<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">${svg}</svg>`} />
) : (
  <span class:list={['icon-svg', className]}>{emoji}</span>
)}
