---
import { getContent } from '../i18n';

interface Props {
	lang?: string;
}
const { lang = 'en' } = Astro.props;
const c = getContent(lang);
const b = c.benchmarks;

type RetrievalRow = { metric: string; gloss: string; linear: string; rrf: string; smart: string };
type RetrievalBlock = {
	subtitle?: string;
	what?: string;
	metricLabel?: string;
	linear?: string;
	rrf?: string;
	smart?: string;
	metricRows?: RetrievalRow[];
	result?: string;
	note?: string;
};
const retrieval = (b as unknown as { retrieval?: RetrievalBlock }).retrieval;

const jsonTokens = 1097;
const toonTokens = 850;
const formatBarPct = Math.round((toonTokens / jsonTokens) * 100);

function splitNum(raw: string): { prefix: string; num: string; suffix: string } {
	const m = raw.trim().match(/^([~≈]?)([\d.]+)([%x×]?)$/);
	if (!m) return { prefix: '', num: raw, suffix: '' };
	return { prefix: m[1], num: m[2], suffix: m[3] };
}
const fmt0 = splitNum(b.format.stats[0].num);
const fmt1 = splitNum(b.format.stats[1].num);
const fmt2 = splitNum(b.format.stats[2].num);

type WfTile = { feature: string; num: string; cap: string; from?: string; to?: string; more?: string };
const wfCards = (b.workflow as unknown as { cards?: WfTile[] }).cards;
const wfTiles: WfTile[] = wfCards
	? wfCards
	: b.workflow.stats.map((s) => {
			const m = s.cap.match(/^(.+?)\s*\(([^)]+)\)$/);
			return { feature: m ? m[2] : b.tabs.workflow, num: s.num, cap: m ? m[1] : s.cap };
	  });
---

<section id="benchmarks" class="content-section benchmarks-section">
	<div class="section-header">
		<h2>{b.title}</h2>
		<p>{b.subtitle}</p>
	</div>

	<p class="bench-lead">{b.workflow.subtitle}</p>

	<div class="bench-grid">
		{
			wfTiles.map((s) => {
				const { prefix, num, suffix } = splitNum(s.num);
				return (
					<div class="metric-tile">
						<span class="tile-kicker">{s.feature}</span>
						<div class="tile-number">
							{prefix && <span class="tile-prefix">{prefix}</span>}
							<span class="tile-count" data-count={num}>{num}</span>
							{suffix && <span class="tile-suffix">{suffix}</span>}
						</div>
						<h3 class="tile-title">{s.cap}</h3>
						{s.from && s.to && (
							<p class="tile-flow">
								<span class="tile-before">{s.from}</span>
								<span class="tile-arrow">→</span>
								<span class="tile-after">{s.to}</span>
							</p>
						)}
						{s.more && <p class="tile-more">{s.more}</p>}
					</div>
				);
			})
		}
	</div>

	<div class="bench-duo">
		<div class="metric-tile highlight">
			<span class="tile-kicker">{b.tabs.format}</span>
			<p class="tile-subtitle">{b.format.subtitle}</p>
			<div class="retrieval-table format-table">
				<div class="retrieval-row retrieval-head">
					<span class="retrieval-metric">{b.retrieval.metricLabel}</span>
					<span class="retrieval-val"></span>
				</div>
				<div class="retrieval-row">
					<span class="retrieval-metric">{b.format.stats[0].cap}</span>
					<span class="retrieval-val">{fmt0.prefix}{fmt0.num}{fmt0.suffix}</span>
				</div>
				<div class="retrieval-row">
					<span class="retrieval-metric">{b.format.stats[1].cap}</span>
					<span class="retrieval-val">{fmt1.prefix}{fmt1.num}{fmt1.suffix}</span>
				</div>
				<div class="retrieval-row">
					<span class="retrieval-metric">{b.format.stats[2].cap}</span>
					<span class="retrieval-val">{fmt2.prefix}{fmt2.num}{fmt2.suffix}</span>
				</div>
			</div>
			<p class="tile-flow">
				<span class="tile-before">JSON {jsonTokens}</span>
				<span class="tile-arrow">→</span>
				<span class="tile-after">TOON {toonTokens}</span>
			</p>
			<div class="tile-bar-track" aria-hidden="true">
				<div class="bar tile-bar bar-toon" data-pct={formatBarPct} style={`--pct:${formatBarPct}%`}></div>
			</div>
			<p class="tile-note" set:html={b.format.note}></p>
		</div>

		<div class="metric-tile ranking-tile">
			<span class="tile-kicker">{b.tabs.ranking}</span>
			<p class="tile-subtitle">{retrieval.subtitle}</p>
			<div class="retrieval-table">
				<div class="retrieval-row retrieval-head">
					<span class="retrieval-metric">{retrieval.metricLabel}</span>
					<span>{retrieval.linear}</span>
					<span class="retrieval-best">{retrieval.rrf}</span>
					<span>{retrieval.smart}</span>
				</div>
				{
					retrieval.metricRows?.map((r: RetrievalRow) => (
						<div class="retrieval-row">
							<span class="retrieval-metric">
								{r.metric}
								{r.gloss && <em>· {r.gloss}</em>}
							</span>
							<span>{r.linear}</span>
							<span class="retrieval-best">{r.rrf}</span>
							<span>{r.smart}</span>
						</div>
					))
				}
			</div>
			<span class="tile-result">{retrieval.result}</span>
			<p class="tile-note" set:html={retrieval.note}></p>
		</div>
	</div>

	<p class="savings-note" set:html={b.workflow.note}></p>
</section>

<script>
	import { animateCountsAndBars, revealCards } from '../scripts/home-anim';
	const root = document.querySelector<HTMLElement>('.benchmarks-section');
	if (root) {
		animateCountsAndBars(root);
		revealCards(root, '.metric-tile');
	}
</script>

<style>
	.benchmarks-section {
		margin-bottom: 5rem;
		padding: 2.5rem 2rem;
		border-radius: 16px;
		background: linear-gradient(135deg, var(--color-accent-brand-ghost-wash), var(--color-accent-lavender-ghost));
		border: 1px solid var(--color-accent-lavender-dim);
	}
	.benchmarks-section .section-header h2 {
		font-size: 2.1rem;
		background: var(--gradient);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}
	.bench-lead {
		margin: 0 0 1.25rem;
		font-size: 0.95rem;
		color: var(--text-muted);
	}
	.bench-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
		margin-bottom: 1.5rem;
	}
	.bench-duo {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
		margin-bottom: 1.75rem;
	}
	.metric-tile {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 1.25rem 1.35rem;
		background: var(--bg-card);
		border: 1px solid var(--border);
		border-radius: 14px;
		transition: border-color 0.25s, transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s;
	}
	.metric-tile:hover {
		border-color: var(--brand);
		transform: translateY(-3px);
		box-shadow: 0 6px 24px -6px var(--brand-glow);
	}
	.metric-tile.highlight {
		border-color: var(--color-accent-lavender-dim);
		background: linear-gradient(180deg, var(--color-accent-brand-ghost-wash), var(--bg-card));
	}
	.metric-tile.pre-reveal {
		opacity: 0;
		transform: translateY(16px);
		transition: opacity 0.6s ease, transform 0.6s ease;
	}
	.metric-tile.revealed {
		opacity: 1;
		transform: none;
	}
	.tile-kicker {
		font-size: 0.72rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-lavender);
	}
	.tile-subtitle {
		margin: 0;
		font-size: 0.85rem;
		color: var(--text-muted);
		line-height: 1.5;
	}
	.tile-number {
		font-size: 2.3rem;
		font-weight: 800;
		line-height: 1.05;
		background: var(--gradient);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}
	.tile-title {
		margin: 0;
		font-size: 0.95rem;
		font-weight: 600;
		color: var(--text);
	}
	.tile-flow {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0;
		font-size: 0.9rem;
		font-weight: 600;
	}
	.tile-more {
		margin-top: auto;
		padding-top: 0.5rem;
		border-top: 1px solid var(--border);
		font-size: 0.8rem;
		color: var(--text-muted);
	}
	.tile-before {
		color: var(--text-muted);
		text-decoration: line-through;
	}
	.tile-arrow {
		color: var(--color-lavender);
	}
	.tile-after {
		color: var(--color-accent-success);
	}
	.tile-bar-track {
		height: 8px;
		border-radius: 9999px;
		overflow: hidden;
		background: var(--bg-card);
		border: 1px solid var(--border);
	}
	.tile-bar {
		padding-right: 0;
		justify-content: flex-start;
		font-size: 0;
	}
	.tile-result {
		align-self: flex-start;
		margin-top: 0.5rem;
		padding: 0.35rem 0.8rem;
		border-radius: 999px;
		background: linear-gradient(135deg, var(--color-accent-success-subtle), var(--color-accent-brand-ghost-wash));
		border: 1px solid var(--color-accent-success-border);
		font-size: 0.8rem;
		font-weight: 700;
		color: var(--text);
	}
	.tile-note {
		margin: 0.5rem 0 0;
		font-size: 0.8rem;
		color: var(--text-muted);
		line-height: 1.55;
	}
	.retrieval-table {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		margin-top: 0.35rem;
	}
	.retrieval-row {
		display: grid;
		grid-template-columns: 10rem 1fr 1fr 1fr;
		align-items: baseline;
		gap: 0.5rem;
		font-size: 0.95rem;
	}
	.retrieval-head {
		font-size: 0.78rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--text-muted);
	}
	.retrieval-metric {
		display: flex;
		align-items: baseline;
		gap: 0.3rem;
		font-weight: 700;
	}
	.retrieval-metric em {
		font-style: normal;
		font-size: 0.72rem;
		font-weight: 500;
		color: var(--text-muted);
	}
	.retrieval-best {
		font-weight: 800;
		background: var(--gradient);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}
	.format-table .retrieval-row {
		grid-template-columns: 1fr 7rem;
	}
	.retrieval-val {
		text-align: right;
		font-weight: 800;
		background: var(--gradient);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}
	.bench-duo .metric-tile {
		justify-content: space-between;
	}
	@media (max-width: 600px) {
		.retrieval-row {
			grid-template-columns: 6rem 1fr 1fr 1fr;
		}
	}
	@media (max-width: 900px) {
		.bench-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (max-width: 768px) {
		.bench-grid,
		.bench-duo {
			grid-template-columns: 1fr;
		}
	}
</style>
