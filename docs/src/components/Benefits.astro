---
import { getContent } from '../i18n';
import Icon from './Icon.astro';

interface Props {
	lang?: string;
}
const { lang = 'en' } = Astro.props;
const c = getContent(lang);
---

<section class="content-section benefits-section">
  <div class="section-header">
    <p class="section-kicker">{c.benefits.kicker}</p>
    <h2>{c.benefits.title}</h2>
    <p>{c.benefits.subtitle}</p>
  </div>

  <div class="benefits-grid">
    {
      c.benefits.groups.map((g) => (
        <div class="benefit-card">
          <div class="benefit-head">
            <div class="benefit-icon"><Icon emoji={g.icon} /></div>
            <h3>{g.title}</h3>
          </div>
          <ul class="benefit-list">
            {g.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
	.benefits-section {
		margin-bottom: 4rem;
	}
	.section-kicker {
		margin: 0 0 0.5rem;
		font-size: 0.78rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--color-lavender);
	}
	.benefits-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1rem;
		margin-top: 1.75rem;
	}
	.benefit-card {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: 1.5rem 1.35rem;
		background: var(--bg-card);
		border: 1px solid var(--border);
		border-radius: 14px;
		transition: border-color 0.25s, transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s;
	}
	.benefit-card:hover {
		border-color: var(--brand);
		transform: translateY(-3px);
		box-shadow: 0 6px 24px -6px var(--brand-glow);
	}
	.benefit-head {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}
	.benefit-icon {
		font-size: 1.4rem;
		flex-shrink: 0;
	}
	.benefit-card h3 {
		font-size: 1.02rem;
		font-weight: 700;
		line-height: 1.3;
	}
	.benefit-list {
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.benefit-list li {
		position: relative;
		padding-left: 1.15rem;
		color: var(--text-muted);
		font-size: 0.85rem;
		line-height: 1.55;
	}
	.benefit-list li::before {
		content: '✓';
		position: absolute;
		left: 0;
		color: var(--color-accent-success);
		font-weight: 700;
	}
	@media (max-width: 900px) {
		.benefits-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (max-width: 560px) {
		.benefits-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
