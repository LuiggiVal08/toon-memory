---
import { getContent } from '../i18n';

interface Props {
	lang?: string;
}
const { lang = 'en' } = Astro.props;
const c = getContent(lang);

const jsonTokens = 1097;
const toonTokens = 850;

const rows = [
  { format: 'JSON', tokens: jsonTokens, cls: 'bar-json' },
  { format: 'TOON', tokens: toonTokens, cls: 'bar-toon' },
];
---

<section class="content-section savings-section">
  <div class="section-header">
    <h2>{c.tokenSavings.title}</h2>
    <p>{c.tokenSavings.subtitle}</p>
  </div>

  <div class="savings-bars">
    {
      rows.map((r) => (
        <div class="savings-bar">
          <span class="savings-label">{r.format}</span>
          <div class="bar-track">
            <div class={`bar ${r.cls}`} style={`--pct:${(r.tokens / jsonTokens) * 100}%`} data-pct={(r.tokens / jsonTokens) * 100}>
              <span>{r.tokens}</span>
            </div>
          </div>
        </div>
      ))
    }
  </div>

  <div class="savings-stats">
    {
      c.tokenSavings.stats.map((s) => (
        <div class="savings-stat">
          <span class="savings-num" data-count={s.num}>{s.num}</span>
          <span class="savings-cap">{s.cap}</span>
        </div>
      ))
    }
  </div>

  <p class="savings-note" set:html={c.tokenSavings.note}></p>
</section>

<script>
  import { animateCountsAndBars } from '../scripts/home-anim';
  const root = document.querySelector<HTMLElement>('.savings-section');
  if (root) animateCountsAndBars(root);
</script>
