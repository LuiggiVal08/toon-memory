---
import { getContent } from '../i18n';

interface Props {
	lang?: string;
}
const { lang = 'en' } = Astro.props;
const c = getContent(lang);
const s = c.smartRecallSection;
---

<section class="content-section smart-recall">
	<div class="section-header">
		<h2>{s.title}</h2>
		<p>{s.subtitle}</p>
	</div>

	<ul class="recall-features">
		{s.points.map((p: string) => <li set:html={p} />)}
	</ul>

	<div class="recall-examples">
		<div class="recall-example">
			<div class="recall-example-header">
				<span class="recall-tag">standard</span>
				<span class="token-badge" data-target="1097">1097 tokens</span>
			</div>
			<pre class="code-block"><code>{s.standardCode}</code></pre>
		</div>

		<div class="recall-arrow" aria-hidden="true">
			<svg viewBox="0 0 40 40" width="40" height="40">
				<circle cx="20" cy="20" r="18" fill="none" stroke="var(--accent, #6cf)" stroke-width="1.5" opacity="0.3" />
				<path d="M14 20h12m-4-4 4 4-4 4" fill="none" stroke="var(--accent, #6cf)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="arrow-path" />
			</svg>
			<span class="arrow-label">−39%</span>
		</div>

		<div class="recall-example compact">
			<div class="recall-example-header">
				<span class="recall-tag compact-tag">compact: true</span>
				<span class="token-badge compact-badge" data-target="520">~520 tokens</span>
			</div>
			<pre class="code-block compact-block"><code>{s.compactCode}</code></pre>
		</div>
	</div>

	<p class="recall-caption">{s.caption}</p>
</section>

<script>
	import { revealOnView } from '../scripts/home-anim';
	const root = document.querySelector<HTMLElement>('.smart-recall');
	if (root) {
		revealOnView(root, 'in-view');

		// Animate token counts when section enters view
		const badges = root.querySelectorAll('.token-badge');
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						badges.forEach((badge) => {
							const target = +(badge as HTMLElement).dataset.target;
							const suffix = badge.classList.contains('compact-badge') ? '~' : '';
							const duration = 800;
							const start = performance.now();
							const animate = (now: number) => {
								const progress = Math.min((now - start) / duration, 1);
								const eased = 1 - Math.pow(1 - progress, 3);
								const current = Math.round(target * eased);
								badge.textContent = `${suffix}${current} tokens`;
								if (progress < 1) requestAnimationFrame(animate);
							};
							requestAnimationFrame(animate);
						});
						observer.disconnect();
					}
				});
			},
			{ threshold: 0.3 }
		);
		observer.observe(root);
	}
</script>

<style>
	.smart-recall {
		background: var(--surface-2, #0f1420);
		padding-top: 3.5rem;
	}
	.recall-features {
		list-style: none;
		padding: 0;
		margin: 0 0 2rem;
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0.75rem 2rem;
	}
	.recall-features li {
		position: relative;
		padding-left: 1.4rem;
		color: var(--text-muted, #aab);
		line-height: 1.5;
		font-size: 0.92rem;
	}
	.recall-features li::before {
		content: '▸';
		position: absolute;
		left: 0;
		color: var(--accent, #6cf);
	}
	.recall-examples {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		gap: 0.75rem;
		align-items: start;
	}
	.recall-example {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}
	.recall-example-header {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}
	.recall-tag {
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--text-muted, #889);
	}
	.compact-tag {
		color: var(--accent, #6cf);
	}
	.token-badge {
		font-size: 0.68rem;
		font-family: var(--font-mono);
		padding: 0.15rem 0.5rem;
		border-radius: 99px;
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid var(--border, #1d2533);
		color: var(--text-muted, #889);
		opacity: 0;
		transform: translateY(4px);
		transition: opacity 0.4s ease 0.6s, transform 0.4s ease 0.6s;
	}
	.smart-recall.in-view .token-badge {
		opacity: 1;
		transform: translateY(0);
	}
	.compact-badge {
		background: color-mix(in srgb, var(--accent, #6cf) 10%, transparent);
		border-color: color-mix(in srgb, var(--accent, #6cf) 30%, transparent);
		color: var(--accent, #6cf);
	}
	/* Arrow between blocks */
	.recall-arrow {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.3rem;
		padding-top: 1.8rem;
		opacity: 0;
		transform: scale(0.7);
		transition: opacity 0.5s ease 0.3s, transform 0.5s ease 0.3s;
	}
	.smart-recall.in-view .recall-arrow {
		opacity: 1;
		transform: scale(1);
	}
	.arrow-path {
		stroke-dasharray: 30;
		stroke-dashoffset: 30;
	}
	.smart-recall.in-view .arrow-path {
		animation: arrowDraw 0.6s ease 0.8s forwards;
	}
	@keyframes arrowDraw {
		to { stroke-dashoffset: 0; }
	}
	.arrow-label {
		font-size: 0.7rem;
		font-family: var(--font-mono);
		color: #22c55e;
		font-weight: 600;
	}
	.code-block {
		margin: 0;
		font-size: 0.8rem;
		line-height: 1.5;
		background: #0b0f18;
		border: 1px solid var(--border, #1d2533);
		border-radius: 10px;
		padding: 0.9rem 1rem;
		overflow-x: auto;
		white-space: pre-wrap;
		word-break: break-word;
	}
	.compact-block {
		border-color: color-mix(in srgb, var(--accent, #6cf) 40%, transparent);
		background: linear-gradient(135deg, #0b0f18 0%, color-mix(in srgb, var(--accent, #6cf) 4%, #0b0f18) 100%);
	}
	.recall-caption {
		margin-top: 1.5rem;
		color: var(--text-muted, #889);
		font-size: 0.92rem;
	}
	@media (max-width: 700px) {
		.recall-features {
			grid-template-columns: 1fr;
		}
		.recall-examples {
			grid-template-columns: 1fr;
			gap: 1rem;
		}
		.recall-arrow {
			flex-direction: row;
			padding-top: 0;
		}
	}
</style>
