---
import { getContent } from '../i18n';

interface Props {
	lang?: string;
}
const { lang = 'en' } = Astro.props;
const c = getContent(lang);

const resources = ['memory-entries', 'memory-stats', 'memory-summaries', 'memory-viewer (ui://viewer)'];

const groupOrder = ['core', 'search', 'context', 'compress', 'sessions', 'sync'];
const groups = c.tools.groups;
const cardsByGroup = new Map<string, typeof c.tools.cards>();
for (const card of c.tools.cards) {
  const g = card.group || 'core';
  if (!cardsByGroup.has(g)) cardsByGroup.set(g, []);
  cardsByGroup.get(g)!.push(card);
}
---

<section class="content-section tools-section">
  <div class="section-header">
    <h2>{c.tools.title}</h2>
    <p>{c.tools.subtitle}</p>
  </div>

  <div class="tools-grid">
    {
      groupOrder.map((g) => {
        const cards = cardsByGroup.get(g);
        if (!cards || cards.length === 0) return null;
        return (
          <>
            <h3 class="tool-group-header">{groups[g] || g}</h3>
            {cards.map((t) => (
              <div class="tool-card">
                <code class="tool-name">{t.name}</code>
                <h3 class="tool-title">{t.title}</h3>
                <p class="tool-desc">{t.desc}</p>
              </div>
            ))}
          </>
        );
      })
    }
  </div>

  <div class="resources-row">
    <span class="resources-label">{c.tools.resourcesLabel}</span>
    {
      resources.map((r) => <code class="resource-pill">{r}</code>)
    }
  </div>
</section>

<script>
  import { revealCards } from '../scripts/home-anim';
  const root = document.querySelector<HTMLElement>('.tools-section');
  if (root) revealCards(root, '.tool-card');
</script>
