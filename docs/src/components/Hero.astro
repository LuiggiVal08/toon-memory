---
import logoSrc from '../assets/logo.svg';
import { getContent } from '../i18n';

interface Props {
	lang?: string;
}
const { lang = 'en' } = Astro.props;
const c = getContent(lang);
const docsHref = lang === 'es' ? '/toon-memory/es/getting-started/quickstart' : '/toon-memory/getting-started/quickstart';

const toonRow = (id: string, cat: string, key: string, content: string, tags: string, date: string) =>
	`  ${id}|${cat}|${key}|${content}||${tags}|${date}||0||0.7|1|${date}T09:12:00.000Z|0`;
const repeat = (s: string) => (s + ' '.repeat(4)).repeat(Math.max(2, Math.ceil(260 / Math.max(s.length, 1))));
const wallA = [
	'version: 1',
	'[200|]{id|category|key|content|file|tags|date|ttl|accessed|links}:',
	toonRow('6f9fa0c7', 'decision', 'stack:nextjs', 'Payments: Stripe. UI: Next.js + Tailwind. Auth: JWT.', 'stack;decision', '2026-08-03'),
	toonRow('7a3a4867', 'bug', 'redis-pool', 'Redis pool: cap at 10 connections to avoid socket timeouts on saturation.', 'redis;bug', '2026-08-03'),
	toonRow('ce358636', 'pattern', 'commit-style', 'Conventional Commits (feat/fix/chore). Short imperative subject, scope in parens.', 'git;pattern', '2026-08-03'),
	'version: 1',
	'[200|]{id|category|key|content|file|tags|date|ttl|accessed|links}:',
	toonRow('2d299473', 'decision', 'graph-single-component', 'All graph APIs must render a single connected component.', 'graph;api', '2026-07-31'),
	toonRow('e4b00a8c', 'warning', 'ttl-default', 'Entries expire after 7 days by default. Set ttl per entry.', 'ttl;default', '2026-07-30'),
	toonRow('8a7e25e7', 'knowledge', 'storage-format', 'Memory lives in .toon-memory/memory/data.toon as pipe-delimited rows.', 'storage;format', '2026-07-29'),
	'version: 1',
	'[200|]{id|category|key|content|file|tags|date|ttl|accessed|links}:',
	toonRow('6f9fa0c7', 'decision', 'stack:nextjs', 'Payments: Stripe. UI: Next.js + Tailwind. Auth: JWT.', 'stack;decision', '2026-08-03'),
	toonRow('7a3a4867', 'bug', 'redis-pool', 'Redis pool: cap at 10 connections to avoid socket timeouts on saturation.', 'redis;bug', '2026-08-03'),
	toonRow('ce358636', 'pattern', 'commit-style', 'Conventional Commits (feat/fix/chore). Short imperative subject, scope in parens.', 'git;pattern', '2026-08-03'),
	toonRow('8a7e25e7', 'knowledge', 'storage-format', 'Memory lives in .toon-memory/memory/data.toon as pipe-delimited rows.', 'storage;format', '2026-07-29'),
].map(repeat).join('\n');
const wallB = [
	'# toon-memory (auto-loaded)',
	'',
	'## pattern: commit-style',
	'Conventional Commits (feat/fix/chore). Short imperative subject, scope in parens.',
	'- tags: git, pattern · date: 2026-08-03',
	'',
	'## bug: redis-pool',
	'Redis pool: cap at 10 connections to avoid socket timeouts on saturation.',
	'- tags: redis, bug · date: 2026-08-03',
	'',
	'## decision: stack:nextjs',
	'Payments: Stripe. UI: Next.js + Tailwind. Auth: JWT.',
	'- tags: stack, decision · date: 2026-08-03',
	'',
	'# toon-memory (auto-loaded)',
	'',
].map(repeat).join('\n');
---

<section class="hero">
  <div class="hero-wall" aria-hidden="true">
    <div class="wall-layer wall-layer-reveal" style="--dur: 60s">
      <pre>{wallB}{'\n'}{wallB}</pre>
    </div>
    <canvas class="hero-wall-mask" id="wallMask" aria-hidden="true"></canvas>
    <div class="wall-layer wall-layer-a" style="--dur: 80s">
      <pre>{wallA}{'\n'}{wallA}</pre>
    </div>
    <div class="wall-layer wall-layer-b" style="--dur: 150s; --top: 30%">
      <pre>{wallB}{'\n'}{wallB}</pre>
    </div>
  </div>

  <div class="hero-header">
    <p class="hero-eyebrow">
      <img src={logoSrc.src} alt="" class="hero-eyebrow-logo" width="18" height="18" />
      <span>toon-memory</span>
      <span class="eyebrow-sep" aria-hidden="true"></span>
      <span>{c.hero.poweredBy}</span>
    </p>
    <h1 class="hero-title">{c.hero.tagline}</h1>
  </div>

  <div class="hero-split">
    <div class="hero-inner">
      <p class="hero-subtitle">{c.hero.subtitle}</p>
      <div class="hero-actions">
        <a href={docsHref} class="btn btn-primary">
          <svg class="icon" viewBox="0 0 24 24" width="16" height="16"><path fill="currentColor" d="M13.22 19.03a.75.75 0 0 1 0-1.06L18.19 13H3.75a.75.75 0 0 1 0-1.5h14.44l-4.97-4.97a.75.75 0 0 1 1.06-1.06l6.25 6.25a.75.75 0 0 1 0 1.06l-6.25 6.25a.75.75 0 0 1-1.06 0z"/></svg>
          {c.hero.getStarted}
        </a>
        <a href="https://github.com/LuiggiVal08/toon-memory" target="_blank" rel="noopener noreferrer" class="btn-github">
          <svg viewBox="0 0 16 16" width="16" height="16"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
          {c.hero.viewGithub}
          <svg class="external-icon" viewBox="0 0 24 24" width="24" height="24"><path fill="currentColor" d="M18 10.82a.75.75 0 0 1-1.5 0V6.56l-7.22 7.22a.75.75 0 0 1-1.06-1.06L15.44 5.5h-4.26a.75.75 0 0 1 0-1.5H18a.75.75 0 0 1 .75.75v6.07z"/><path fill="currentColor" d="M5.5 6.25A2.25 2.25 0 0 1 7.75 4h4.5a.75.75 0 0 1 0 1.5h-4.5a.75.75 0 0 0-.75.75v11.5c0 .414.336.75.75.75h11.5a.75.75 0 0 0 .75-.75v-4.5a.75.75 0 0 1 1.5 0v4.5a2.25 2.25 0 0 1-2.25 2.25H7.75A2.25 2.25 0 0 1 5.5 17.75V6.25z"/></svg>
        </a>
      </div>
    </div>

    <div class="hero-terminal">
      <div class="terminal-bar">
        <span class="terminal-dot" aria-hidden="true"></span>
        <span class="terminal-dot" aria-hidden="true"></span>
        <span class="terminal-dot" aria-hidden="true"></span>
        <span class="terminal-title">~/.toon-memory</span>
      </div>
      <div class="terminal-body">
        <p class="term-install">
          <span class="term-prompt">$</span>
          <span class="term-cmd">{c.hero.installCmd}</span>
          <span class="term-cursor" aria-hidden="true"></span>
          <button id="installBtn" class="term-copy" type="button" aria-label={c.hero.copy} title={c.hero.copy}>
            <svg class="install-copy" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
            <svg class="install-done" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </button>
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    document.getElementById('installBtn')?.addEventListener('click', function () {
      navigator.clipboard.writeText('npm install -g toon-memory').then(() => {
        this.classList.add('copied');
        setTimeout(() => this.classList.remove('copied'), 1500);
      });
    });
  })();

  (function () {
    // MiMo-style reveal: the memory wall emerges under the cursor through
    // expanding ink blots carved into a mask canvas (destination-out).
    const hero = document.querySelector('.hero');
    const canvas = document.getElementById('wallMask');
    if (!hero || !canvas) return;
    if (window.matchMedia('(hover: none)').matches) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const R_START = 6;
    const R_END = 120;
    const R_VARY = 0.45;
    const LIFETIME = 520;
    const STAMP_STEP = 12;
    const MAX_STAMPS = 160;
    const DPR = Math.min(window.devicePixelRatio || 1, 2);

    let w = 0;
    let h = 0;
    const stamps = [];
    let lastX = null;
    let lastY = null;

    function bgColor() {
      const c = getComputedStyle(document.body).backgroundColor;
      const tmp = document.createElement('canvas');
      tmp.width = tmp.height = 1;
      const tctx = tmp.getContext('2d', { willReadFrequently: true });
      tctx.fillStyle = c;
      tctx.fillRect(0, 0, 1, 1);
      const d = tctx.getImageData(0, 0, 1, 1).data;
      return d[0] + ',' + d[1] + ',' + d[2];
    }
    const MASK = bgColor();

    function resize() {
      const rect = hero.getBoundingClientRect();
      w = rect.width;
      h = rect.height;
      canvas.width = Math.round(w * DPR);
      canvas.height = Math.round(h * DPR);
      canvas.style.width = w + 'px';
      canvas.style.height = h + 'px';
      ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
      ctx.globalCompositeOperation = 'source-over';
      ctx.fillStyle = 'rgb(' + MASK + ')';
      ctx.fillRect(0, 0, w, h);
    }
    resize();
    window.addEventListener('resize', resize);

    function addStamp(x, y) {
      if (stamps.length >= MAX_STAMPS) stamps.shift();
      stamps.push({
        x: x,
        y: y,
        born: performance.now(),
        seed: Math.random() * Math.PI * 2,
        rmax: R_END * (1 - R_VARY + Math.random() * R_VARY),
      });
    }

    function stampAlong(x, y) {
      if (lastX === null) {
        addStamp(x, y);
      } else {
        const dx = x - lastX;
        const dy = y - lastY;
        const dist = Math.hypot(dx, dy);
        const steps = Math.max(1, Math.ceil(dist / STAMP_STEP));
        for (let i = 1; i <= steps; i++) {
          addStamp(lastX + (dx * i) / steps, lastY + (dy * i) / steps);
        }
      }
      lastX = x;
      lastY = y;
      start();
    }

    function carveInk(x, y, r, alpha, seed) {
      const g = ctx.createRadialGradient(x, y, r * 0.25, x, y, r);
      g.addColorStop(0, 'rgba(0, 0, 0, ' + 0.95 * alpha + ')');
      g.addColorStop(0.55, 'rgba(0, 0, 0, ' + 0.88 * alpha + ')');
      g.addColorStop(1, 'rgba(0, 0, 0, 0)');
      ctx.fillStyle = g;
      ctx.beginPath();
      const segs = 32;
      for (let i = 0; i <= segs; i++) {
        const a = (i / segs) * Math.PI * 2;
        const wob =
          0.78 +
          0.14 * Math.sin(a * 3 + seed) +
          0.08 * Math.sin(a * 7 + seed * 2.1) +
          0.05 * Math.sin(a * 13 + seed * 0.7);
        const rr = r * wob;
        const px = x + Math.cos(a) * rr;
        const py = y + Math.sin(a) * rr;
        if (i === 0) ctx.moveTo(px, py);
        else ctx.lineTo(px, py);
      }
      ctx.closePath();
      ctx.fill();
    }

    let running = false;
    function loop() {
      const now = performance.now();
      ctx.globalCompositeOperation = 'source-over';
      ctx.fillStyle = 'rgb(' + MASK + ')';
      ctx.fillRect(0, 0, w, h);
      ctx.globalCompositeOperation = 'destination-out';
      for (let i = stamps.length - 1; i >= 0; i--) {
        const t = (now - stamps[i].born) / LIFETIME;
        if (t >= 1) {
          stamps.splice(i, 1);
          continue;
        }
        const ease = 1 - Math.pow(1 - t, 3);
        const r = R_START + (stamps[i].rmax - R_START) * ease;
        const alpha = 1 - t * t;
        carveInk(stamps[i].x, stamps[i].y, r, alpha, stamps[i].seed);
      }
      if (stamps.length) {
        requestAnimationFrame(loop);
      } else {
        running = false;
      }
    }

    function start() {
      if (!running) {
        running = true;
        requestAnimationFrame(loop);
      }
    }

    hero.addEventListener('mouseenter', function (e) {
      const rect = hero.getBoundingClientRect();
      lastX = e.clientX - rect.left;
      lastY = e.clientY - rect.top;
      stampAlong(lastX, lastY);
    });
    hero.addEventListener('mousemove', function (e) {
      const rect = hero.getBoundingClientRect();
      stampAlong(e.clientX - rect.left, e.clientY - rect.top);
    });
    hero.addEventListener('mouseleave', function () {
      lastX = null;
      lastY = null;
    });
  })();
</script>
