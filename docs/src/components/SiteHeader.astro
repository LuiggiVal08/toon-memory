---
import logoSrc from '../assets/logo.svg';
import logoIsologoSrc from '../assets/logo-isologo.svg';
import { getContent } from '../i18n';
import pkg from '../../../package.json';

const version = pkg.version;

interface Props {
	lang?: string;
}
const { lang = 'en' } = Astro.props;
const c = getContent(lang);

const locales = [
	{ code: 'en', label: 'English' },
	{ code: 'es', label: 'Español' },
	{ code: 'zh', label: '中文' },
	{ code: 'ja', label: '日本語' },
	{ code: 'ko', label: '한국어' },
	{ code: 'pt-br', label: 'Português (BR)' },
	{ code: 'de', label: 'Deutsch' },
	{ code: 'fr', label: 'Français' },
];

function getLocalePath(locale: string) {
	return locale === 'en' ? '/toon-memory/' : `/toon-memory/${locale}/`;
}

const currentLocale = locales.find(l => l.code === lang) || locales[0];
const docsHref = getLocalePath(lang) + 'getting-started/quickstart';
---

<header class="site-header">
  <a href={getLocalePath(lang)} class="site-logo" aria-label="toon-memory">
    <img src={logoSrc.src} alt="" class="logo-icon" />
    <img src={logoIsologoSrc.src} alt="toon-memory" class="logo-isologo" />
  </a>
  <nav class="site-nav">
    <a href={docsHref}>{c.nav.docs}</a>
    <div class="nav-links" id="navLinks">
      <a href="#faq" class="nav-anchor">{c.nav.faq}</a>
      <div class="lang-dropdown version-dropdown">
        <button class="lang-switch version-switch" type="button" aria-haspopup="true" aria-expanded="false">
          <span>v{version}</span>
          <svg class="switch-chevron" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>
        <div class="lang-dropdown-menu version-dropdown-menu">
          <a
            class="lang-option"
            href="https://github.com/LuiggiVal08/toon-memory/releases"
            target="_blank"
            rel="noopener noreferrer"
          >{c.nav.releaseNotes}</a>
        </div>
      </div>
      <div class="lang-dropdown">
        <button class="lang-switch" type="button" aria-haspopup="true" aria-expanded="false">{currentLocale.label}
          <svg class="switch-chevron" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>
        <div class="lang-dropdown-menu">
          {locales.map(l => (
            <a
              href={getLocalePath(l.code)}
              class:list={['lang-option', { active: l.code === lang }]}
              onclick={`localStorage.setItem('toon-lang', '${l.code}')`}
            >{l.label}</a>
          ))}
        </div>
      </div>
      <a href="https://www.npmjs.com/package/toon-memory" target="_blank" rel="noopener noreferrer" class="npm-link">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M1.76 0h20.48a1.76 1.76 0 0 1 1.76 1.76v20.48a1.76 1.76 0 0 1-1.76 1.76H1.76A1.76 1.76 0 0 1 0 22.24V1.76A1.76 1.76 0 0 1 1.76 0zM5.11 19.16h6.93V8.8h3.47v10.36h3.47V5.34H5.13v13.82z"/></svg>
        <span>npm</span>
      </a>
    </div>
    <button class="nav-toggle" type="button" aria-label="Menu" aria-expanded="false" aria-controls="navLinks">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line class="nav-toggle-line-1" x1="4" y1="7" x2="20" y2="7"></line>
        <line class="nav-toggle-line-2" x1="4" y1="12" x2="20" y2="12"></line>
        <line class="nav-toggle-line-3" x1="4" y1="17" x2="20" y2="17"></line>
      </svg>
    </button>
  </nav>
</header>
<script is:inline>
  (function () {
    var toggle = document.querySelector('.nav-toggle');
    var links = document.querySelector('#navLinks');
    var dropdowns = Array.prototype.slice.call(document.querySelectorAll('.lang-dropdown'));

    function closeNav() {
      if (!toggle || !links) return;
      links.classList.remove('open');
      toggle.classList.remove('open');
      toggle.setAttribute('aria-expanded', 'false');
    }

    function closeMenus() {
      dropdowns.forEach(function (d) {
        var menu = d.querySelector('.lang-dropdown-menu');
        var btn = d.querySelector('.lang-switch');
        if (menu) menu.classList.remove('open');
        if (btn) btn.setAttribute('aria-expanded', 'false');
      });
    }

    if (toggle && links) {
      toggle.addEventListener('click', function (e) {
        e.stopPropagation();
        var open = links.classList.toggle('open');
        toggle.classList.toggle('open', open);
        toggle.setAttribute('aria-expanded', String(open));
      });
      links.querySelectorAll('a').forEach(function (a) {
        a.addEventListener('click', function () { closeNav(); });
      });
    }
    var anchors = document.querySelectorAll('.nav-anchor');
    anchors.forEach(function (a) {
      a.addEventListener('click', function (e) {
        var href = a.getAttribute('href');
        if (!href || href.charAt(0) !== '#') return;
        var target = document.getElementById(href.slice(1));
        if (!target) return;
        e.preventDefault();
        closeNav();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });
    dropdowns.forEach(function (d) {
      var btn = d.querySelector('.lang-switch');
      var menu = d.querySelector('.lang-dropdown-menu');
      if (!btn || !menu) return;
      btn.addEventListener('click', function (e) {
        e.stopPropagation();
        var wasOpen = menu.classList.contains('open');
        closeMenus();
        if (wasOpen) {
          btn.setAttribute('aria-expanded', 'false');
        } else {
          menu.classList.add('open');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });
    document.addEventListener('click', function () {
      closeNav();
      closeMenus();
    });
  })();
</script>
