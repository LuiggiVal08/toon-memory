---
import logoSrc from '../assets/logo.svg';
import { getContent } from '../i18n';

interface Props {
	lang?: string;
}
const { lang = 'en' } = Astro.props;
const c = getContent(lang);

const locales = [
	{ code: 'en', label: 'English' },
	{ code: 'es', label: 'Español' },
	{ code: 'zh', label: '中文' },
	{ code: 'ja', label: '日本語' },
	{ code: 'ko', label: '한국어' },
	{ code: 'pt-br', label: 'Português (BR)' },
	{ code: 'de', label: 'Deutsch' },
	{ code: 'fr', label: 'Français' },
];

function getLocalePath(locale: string) {
	return locale === 'en' ? '/toon-memory/' : `/toon-memory/${locale}/`;
}

const currentLocale = locales.find(l => l.code === lang) || locales[0];
const docsHref = getLocalePath(lang) + 'getting-started/quickstart';
---

<header class="site-header">
  <a href={getLocalePath(lang)} class="site-logo">
    <img src={logoSrc.src} alt="toon-memory" class="logo-icon" />
    <span class="logo-text">toon-memory</span>
  </a>
  <nav class="site-nav">
    <a href={docsHref}>{c.nav.docs}</a>
    <a href="#features" class="nav-anchor">{c.nav.features}</a>
    <a href="#viewer" class="nav-anchor">{c.nav.viewer}</a>
    <a href="#benchmarks" class="nav-anchor">{c.nav.benchmarks}</a>
    <a href="#faq" class="nav-anchor">{c.nav.faq}</a>
    <a href="https://github.com/LuiggiVal08/toon-memory" target="_blank" rel="noopener noreferrer" class="nav-anchor github-link">
      <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
      {c.nav.github}
    </a>
    <div class="lang-dropdown">
      <button class="lang-switch" type="button">{currentLocale.label}</button>
      <div class="lang-dropdown-menu">
        {locales.map(l => (
          <a
            href={getLocalePath(l.code)}
            class:list={['lang-option', { active: l.code === lang }]}
            onclick={`localStorage.setItem('toon-lang', '${l.code}')`}
          >{l.label}</a>
        ))}
      </div>
    </div>
    <a href="https://www.npmjs.com/package/toon-memory" target="_blank" rel="noopener noreferrer" class="npm-link">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M1.76 0h20.48a1.76 1.76 0 0 1 1.76 1.76v20.48a1.76 1.76 0 0 1-1.76 1.76H1.76A1.76 1.76 0 0 1 0 22.24V1.76A1.76 1.76 0 0 1 1.76 0zM5.11 19.16h6.93V8.8h3.47v10.36h3.47V5.34H5.13v13.82z"/></svg>
      <span>npm</span>
    </a>
  </nav>
</header>
<script is:inline>
  (function () {
    var btn = document.querySelector('.lang-switch');
    var menu = document.querySelector('.lang-dropdown-menu');
    if (!btn || !menu) return;
    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      menu.classList.toggle('open');
    });
    document.addEventListener('click', function () {
      menu.classList.remove('open');
    });
  })();
</script>
