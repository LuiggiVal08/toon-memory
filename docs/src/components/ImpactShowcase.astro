---
import { getContent } from '../i18n';

interface Props {
	lang?: string;
}
const { lang = 'en' } = Astro.props;
const c = getContent(lang);
const s = c.impactSection;

// Benchmark 1: auto-loading — ~90% token savings
const autoLoadWithoutPct = 100;
const autoLoadWithPct = 10;

// Benchmark 2: memory_recall compact vs re-reading files (68.5% savings)
const recallWithoutPct = 100;
const recallWithPct = 31.5;

// Benchmark 3: full session — tool calls 25→5 (80% fewer)
const sessionWithoutPct = 100;
const sessionWithPct = 20;

// Benchmark 4: primer — 58.4% token savings, 4→0 tool calls
const primerWithoutPct = 100;
const primerWithPct = 41.6;

// Benchmark 5: compress-all — 14.3% token savings
const compressBeforePct = 100;
const compressAfterPct = 85.7;
---

<section class="content-section impact-section">
	<div class="section-header">
		<h2>{s.title}</h2>
		<p>{s.subtitle}</p>
	</div>

	<div class="benchmark-grid">
		<div class="benchmark-block highlight">
			<h3 class="benchmark-label">{lang === 'es' ? 'Auto-carga: solo file path relevante' : 'Auto-loading: only relevant file path'}</h3>
			<div class="savings-bars impact-bars">
				<div class="savings-bar">
					<span class="savings-label">{lang === 'es' ? 'Sin auto-carga (dump completo)' : 'Without auto-loading (full dump)'}</span>
					<div class="bar-track">
						<div class="bar bar-json" style={`--pct:${autoLoadWithoutPct}%`} data-pct={autoLoadWithoutPct}><span>{autoLoadWithoutPct}%</span></div>
					</div>
				</div>
				<div class="savings-bar">
					<span class="savings-label">{lang === 'es' ? 'Con auto-loading (~90% ahorro)' : 'With auto-loading (~90% savings)'}</span>
					<div class="bar-track">
						<div class="bar bar-toon" style={`--pct:${autoLoadWithPct}%`} data-pct={autoLoadWithPct}><span>{autoLoadWithPct}%</span></div>
					</div>
				</div>
			</div>
		</div>

		<div class="benchmark-block">
			<h3 class="benchmark-label">{lang === 'es' ? 'Recall compacto vs re-leer archivos' : 'Compact recall vs re-reading files'}</h3>
			<div class="savings-bars impact-bars">
				<div class="savings-bar">
					<span class="savings-label">{lang === 'es' ? 'Re-leer archivos' : 'Re-read files'}</span>
					<div class="bar-track">
						<div class="bar bar-json" style={`--pct:${recallWithoutPct}%`} data-pct={recallWithoutPct}><span>{recallWithoutPct}%</span></div>
					</div>
				</div>
				<div class="savings-bar">
					<span class="savings-label">{lang === 'es' ? 'memory_recall compacto' : 'memory_recall compact'}</span>
					<div class="bar-track">
						<div class="bar bar-toon" style={`--pct:${recallWithPct}%`} data-pct={recallWithPct}><span>{recallWithPct}%</span></div>
					</div>
				</div>
			</div>
		</div>

		<div class="benchmark-block">
			<h3 class="benchmark-label">{lang === 'es' ? 'Sesión completa: tool calls' : 'Full session: tool calls'}</h3>
			<div class="savings-bars impact-bars">
				<div class="savings-bar">
					<span class="savings-label">{lang === 'es' ? 'Sin memoria (25 calls)' : 'Without memory (25 calls)'}</span>
					<div class="bar-track">
						<div class="bar bar-json" style={`--pct:${sessionWithoutPct}%`} data-pct={sessionWithoutPct}><span>{sessionWithoutPct}%</span></div>
					</div>
				</div>
				<div class="savings-bar">
					<span class="savings-label">{lang === 'es' ? 'Con context_* (5 calls)' : 'With context_* (5 calls)'}</span>
					<div class="bar-track">
						<div class="bar bar-toon" style={`--pct:${sessionWithPct}%`} data-pct={sessionWithPct}><span>{sessionWithPct}%</span></div>
					</div>
				</div>
			</div>
		</div>

		<div class="benchmark-block">
			<h3 class="benchmark-label">{lang === 'es' ? 'System primer: auto-inyección' : 'System primer: auto-injection'}</h3>
			<div class="savings-bars impact-bars">
				<div class="savings-bar">
					<span class="savings-label">{lang === 'es' ? '4 recalls manuales' : '4 manual recalls'}</span>
					<div class="bar-track">
						<div class="bar bar-json" style={`--pct:${primerWithoutPct}%`} data-pct={primerWithoutPct}><span>{primerWithoutPct}%</span></div>
					</div>
				</div>
				<div class="savings-bar">
					<span class="savings-label">{lang === 'es' ? 'Primer automático (0 calls)' : 'Auto primer (0 calls)'}</span>
					<div class="bar-track">
						<div class="bar bar-toon" style={`--pct:${primerWithPct}%`} data-pct={primerWithPct}><span>{primerWithPct}%</span></div>
					</div>
				</div>
			</div>
		</div>

		<div class="benchmark-block">
			<h3 class="benchmark-label">{lang === 'es' ? 'Compresión por lotes' : 'Batch compression'}</h3>
			<div class="savings-bars impact-bars">
				<div class="savings-bar">
					<span class="savings-label">{lang === 'es' ? 'Sin comprimir (30)' : 'Uncompressed (30)'}</span>
					<div class="bar-track">
						<div class="bar bar-json" style={`--pct:${compressBeforePct}%`} data-pct={compressBeforePct}><span>{compressBeforePct}%</span></div>
					</div>
				</div>
				<div class="savings-bar">
					<span class="savings-label">{lang === 'es' ? 'Comprimido (20)' : 'Compressed (20)'}</span>
					<div class="bar-track">
						<div class="bar bar-toon" style={`--pct:${compressAfterPct}%`} data-pct={compressAfterPct}><span>{compressAfterPct}%</span></div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<div class="savings-stats impact-stats">
		{
			s.stats.map((st: { num: string; cap: string }) => (
				<div class="savings-stat">
					<span class="savings-num impact-num" data-count={st.num}>{st.num}</span>
					<span class="savings-cap">{st.cap}</span>
				</div>
			))
		}
	</div>

	<p class="savings-note" set:html={s.note}></p>
</section>

<script>
	import { animateCountsAndBars } from '../scripts/home-anim';
	const root = document.querySelector<HTMLElement>('.impact-section');
	if (root) animateCountsAndBars(root);
</script>

<style>
	.content-section.impact-section {
		margin-bottom: 3.5rem;
		padding: 2.5rem 2rem;
		border-radius: 16px;
		background: linear-gradient(135deg, var(--color-accent-brand-ghost-wash), var(--color-accent-lavender-ghost));
		border: 1px solid var(--color-accent-lavender-dim);
	}
	.impact-section .section-header {
		margin-bottom: 1.5rem;
	}
	.impact-section .section-header h2 {
		font-size: 2.1rem;
		background: var(--gradient);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}
	.impact-num {
		font-size: 2.4rem;
		background: var(--gradient);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}
	.impact-stats {
		margin-top: 1.5rem;
	}
	.benchmark-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.5rem;
		margin-bottom: 1.5rem;
	}
	.benchmark-block {
		padding: 1.25rem;
		border-radius: 12px;
		background: var(--color-accent-brand-ghost);
		border: 1px solid var(--color-accent-lavender-dim);
	}
	.benchmark-block.highlight {
		grid-column: 1 / -1;
		border-color: var(--color-accent-success-border);
		background: linear-gradient(135deg, var(--color-accent-success-subtle), var(--color-accent-brand-ghost-wash));
	}
	.benchmark-label {
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--color-lavender);
		margin-bottom: 1rem;
		text-transform: uppercase;
		letter-spacing: .05em;
	}
	.benchmark-block.highlight .benchmark-label {
		color: var(--color-accent-success-mist);
	}
	@media (max-width: 768px) {
		.benchmark-grid {
			grid-template-columns: 1fr;
		}
		.benchmark-block.highlight {
			grid-column: 1;
		}
	}
</style>
