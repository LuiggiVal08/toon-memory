---
import { getContent } from '../i18n';

interface Props {
	lang?: string;
}
const { lang = 'en' } = Astro.props;
const c = getContent(lang);
const t = c.viewerSection || c.graphSection;
const points = ((t.features || t.points) as string[]) || [];
---

<section id="viewer" class="content-section graph-showcase">
	<div class="section-header">
		<h2>{t.title}</h2>
		<p>{t.subtitle}</p>
	</div>

	<div class="graph-grid">
		<div class="graph-text">
			<ul class="graph-points">
				{points.map((p) => <li set:html={p} />)}
			</ul>
			<pre class="code-block graph-code"><code>{`npx toon-memory viewer        # CLI (HTTP server)
memory_visualize()             # Inline in MCP Apps-compatible hosts`}</code></pre>
			<p class="graph-caption">Press <kbd>r</kbd> in terminal to reload, or call <code>memory_visualize()</code> for inline rendering.</p>
		</div>

		<div class="graph-viz">
			<iframe src="/toon-memory/viewer/embed.html" class="viewer-iframe" title="Interactive memory graph viewer" loading="lazy" allow="fullscreen"></iframe>
			<p class="graph-caption">Interactive graph — click nodes, search, explore paths in real time</p>
		</div>
	</div>
</section>
