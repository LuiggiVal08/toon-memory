---
import { getContent } from '../i18n';
import Icon from './Icon.astro';

interface Props {
	lang?: string;
}
const { lang = 'en' } = Astro.props;
const c = getContent(lang);
---

<div id="features" class="feature-cards">
  {
    c.features.cards.map((f, i) => (
      <div class={`card${i === 0 ? ' featured' : ''}${f.wide ? ' card-wide' : ''}`}>
        <div class="card-icon"><Icon emoji={f.icon} /></div>
        <h3>{f.title}</h3>
        <p>{f.body}</p>
        {f.toolGroups && (
          <div class="card-tools">
            {f.toolGroups.map((g) => (
              <div class="tool-group">
                <span class="tool-group-label">{g.label}</span>
                <div class="tool-chips">
                  {g.tools.map((t) => <code class="tool-chip">{t}</code>)}
                </div>
              </div>
            ))}
          </div>
        )}
        {f.tags && (
          <div class="card-tags">
            {f.tags.map((t) => <span class="tag">{t}</span>)}
          </div>
        )}
        {f.stats && (
          <div class="card-stats">
            {f.stats.map((s) => <span class="stat">{s}</span>)}
          </div>
        )}
      </div>
    ))
  }
</div>
